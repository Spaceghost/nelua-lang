require 'string'

local function crc32_table(): [256]uint32
  local t: [256]uint32
  for i: uint32 = 0, 255 do
    local c: uint32 = i
    for _ = 1, 8 do
      if c & 1 == 1 then
        c = 0xEDB88320 ~ (c >> 1)
      else
        c = c >> 1
      end
    end
    t[i] = c
  end
  return t
end

local function fib(n: integer): integer
  if n < 2 then return n end
  return fib(n - 1) + fib(n - 2)
end

local function build(n: integer): string
  local s: string = ''
  for i = 1, n do
    s = s .. tostring(i) .. ','
  end
  return s
end

local function wrap8(x: uint8): uint8
  return x + 250
end

local function overflow32(x: int32): int32
  return x * 65536 * 32768
end

local function round32(x: float32): float32
  return x / 3
end

local function negdiv(a: integer, b: integer): (integer, integer)
  return a // b, a % b
end

local function shifts(x: int32, n: integer): (int32, int32, uint32)
  return x << n, x >> n, (@uint32)(x) >> n
end

local function fast_pow(b: integer, e: integer): integer <comptime>
  local r = 1
  for _ = 1, e do r = r * b end
  return r
end

do -- crc32 table
  local CT = comptime(crc32_table())
  local rt = crc32_table()
  for i = 0, 255 do
    assert(CT[i] == rt[i])
  end
  assert(CT[1] == 0x77073096 and CT[255] == 0x2D02EF8D)
end

do -- fib
  local F <comptime> = comptime(fib(20))
  assert(F == 6765 and F == fib(20))
end

do -- string building
  local S <comptime> = comptime(build(5))
  assert(S == '1,2,3,4,5,' and S == build(5))
end

do -- uint8 wrap
  local W <comptime> = comptime(wrap8(10))
  assert(W == 4 and W == wrap8(10))
end

do -- int32 overflow
  local O <comptime> = comptime(overflow32(3))
  assert(O == overflow32(3))
end

do -- float32 rounding
  local R <comptime> = comptime(round32(1.0))
  assert(R == round32(1.0))
end

do -- floor division and modulo on negatives
  local Q <comptime>, M <comptime> = comptime(negdiv(-7, 2))
  local q, m = negdiv(-7, 2)
  assert(Q == -4 and M == 1 and Q == q and M == m)
end

do -- shifts
  local A <comptime>, B <comptime>, C <comptime> = comptime(shifts(-8, 2))
  local a, b, c = shifts(-8, 2)
  assert(A == a and B == b and C == c)
end

do -- <comptime> function
  local P = fast_pow(3, 7)
  assert(P == 2187)
end

local function f32str(x: float32): string
  return tostring(x) .. '|' .. tostring(x * 3)
end

do -- float32 formatting
  local S <comptime> = comptime(f32str(1.1))
  assert(S == f32str(1.1))
end

local Vec = @record{x: integer, y: integer}
function Vec:add(o: Vec) self.x = self.x + o.x self.y = self.y + o.y end

local function sumvec(n: integer): Vec
  local acc: Vec
  for i = 1, n do
    acc:add(Vec{i, i * i})
  end
  local copy = acc
  copy.x = 0 -- a copy, `acc` keeps its value
  return acc
end

do -- records, methods and copies
  local V = comptime(sumvec(4))
  local v = sumvec(4)
  assert(V.x == v.x and V.y == v.y and V.x == 10 and V.y == 30)
end

local Config = @record{
  origin: Vec,
  points: [2]Vec,
  label: string,
  enabled: boolean,
  gain: float32,
  code: uint8,
}

local function configured(c: Config): (integer, float32, uint8)
  local copy = c
  copy.origin.x = 999
  copy.points[0].y = 999
  c.origin.x = c.origin.x + 1
  if not c.enabled or c.label ~= 'radio' then return -1, c.gain, c.code end
  return c.origin.x * 100 + c.origin.y * 10 + c.points[0].y + c.points[1].x, c.gain / 3, c.code
end

do -- record inputs, nested arrays of records, defaults and value semantics
  local A <comptime>, G <comptime>, C <comptime> = comptime(configured(Config{
    origin = {2, 3}, points = {{4, 5}, {6}}, label = 'radio', enabled = true, gain = 1.1, code = 250
  }))
  local a, g, c = configured(Config{
    origin = {2, 3}, points = {{4, 5}, {6}}, label = 'radio', enabled = true, gain = 1.1, code = 250
  })
  assert(A == 341 and A == a and G == g and C == 250 and C == c)
  local Z <comptime>, ZG <comptime>, ZC <comptime> = comptime(configured(Config()))
  assert(Z == -1 and ZG == 0 and ZC == 0)
end

local function sum_points(points: [3]Vec): integer
  points[0].x = points[0].x + 1
  return points[0].x + points[1].y + points[2].x
end

local SETTINGS <comptime> = Config{
  origin = {2, 3}, points = {{4, 5}, {6}}, label = 'radio', enabled = true, gain = 1.1, code = 250
}
local function global_gain(): float64 return (@float64)(SETTINGS.gain) end
local GLOBAL_GAIN <comptime> = comptime(global_gain())
local POINTS: [3]Vec <comptime> = {SETTINGS.origin, {7, 8}}

do -- reusable constants, field lookup and independent runtime copies
  local A <comptime>, G <comptime>, C <comptime> = comptime(configured(SETTINGS))
  assert(A == 341 and C == 250)
  local a, g, c = configured(SETTINGS)
  assert(A == a and G == g and C == c)
  local first, second = SETTINGS, SETTINGS
  assert(GLOBAL_GAIN == (@float64)(second.gain))
  first.origin.x = 90
  first.points[0].y = 91
  assert(second.origin.x == 2 and second.points[0].y == 5)
  assert(SETTINGS.origin.x == 2 and SETTINGS.points[1].y == 0)
  local values = POINTS
  values[0].x = 99
  assert(POINTS[0].x == 2 and POINTS[2].y == 0)
  local index = 1
  assert(POINTS[index].y == 8)
  local function from_global(): integer return SETTINGS.origin.x + POINTS[1].y end
  local TOTAL <comptime> = comptime(from_global())
  assert(TOTAL == 10)
end

do -- field names that need C identifier quoting
  local R = @record{default: integer}
  local CONFIG <comptime> = R{default = 5}
  local copy = CONFIG
  assert(copy.default == 5)
end

do -- records inside array arguments, and folded record results as inputs
  local S <comptime> = comptime(sum_points({{1}, {0, 2}}))
  assert(S == 4 and S == sum_points({{1}, {0, 2}}))
  local function sum(v: Vec): integer return v.x + v.y end
  local V <comptime> = comptime(sum(comptime(sumvec(4))))
  assert(V == 40)
end

local function strops(s: string): string
  return s:upper() .. string.rep('-', 2) .. s:sub(2, 2) .. tostring(#s) .. string.format('%03d', 7)
end

do -- string library
  local T <comptime> = comptime(strops('ab'))
  assert(T == strops('ab') and T == 'AB--b2007')
end

print('comptime OK!')
