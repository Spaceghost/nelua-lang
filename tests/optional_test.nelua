require 'optional'
require 'variant'
require 'string'
require 'io'
require 'os'

do -- construction and queries
  local o: optional(integer)
  assert(not o:has() and o == nil and o:getptr() == nilptr)
  assert(o:get_or(5) == 5)
  o = 10
  assert(o:has() and o ~= nil and o == 10 and 10 == o)
  assert(o:get() == 10 and o:get_or(5) == 10)
  assert($o:getptr() == 10)
  $o:getptr() = 11
  assert(o:get() == 11)
  o:set(20)
  assert(o:get() == 20)
  o:clear()
  assert(not o:has() and o == nil)
  o = 3
  o = nil
  assert(o == nil)
end

do -- shorthand syntax and implicit conversions
  local a: integer? = 1
  local b: string? = 'hello'
  local c: float64? = nil
  assert(a == 1 and b == 'hello' and c == nil)
  assert(#@integer? > #@integer)
  local function describe(x: integer?): string
    if x then return 'some ' .. tostring(x:get()) end
    return 'none'
  end
  assert(describe(3) == 'some 3')
  assert(describe(nil) == 'none')
  assert(describe(a) == 'some 1')
  local function find(k: integer): integer?
    if k == 1 then return 10 end
    return nil
  end
  assert(find(1) == 10 and find(2) == nil)
  local x = find(1) -- inferred as `integer?`
  local y: integer = x:get()
  assert(x == 10 and y == 10)
end

do -- comparisons between optionals
  local a: integer? = 1
  local b: integer? = 1
  local c: integer? = 2
  local e: integer?
  local f: integer?
  assert(a == b and a ~= c and a ~= e and e == f and e ~= 1 and not (e == 1))
  assert(a == 1 and 1 == a and c ~= 1)
  local P = @record{x: integer, y: integer}
  local p: P? = (@P){x = 1, y = 2}
  local q: P? = (@P){x = 1, y = 2}
  assert(p == q and p == (@P){x = 1, y = 2} and p ~= (@P){x = 1, y = 3})
  local s: string? = 'a'
  assert(s == 'a' and 'a' == s and s ~= 'b' and s ~= nil)
  assert(s:get() == 'a' and s:get_or('z') == 'a')
end

do -- pointers use the niche layout
  local n: integer = 7
  local p: *integer? = &n
  assert(#@*integer? == #@*integer)
  assert(p:has() and p ~= nil and p ~= nilptr and $p:get() == 7)
  assert(p == &n)
  p = nilptr
  assert(not p:has() and p == nil and p == nilptr)
  local np: *integer = nilptr
  p = np -- a null pointer converts to empty
  assert(p == nil)
  p:set(&n)
  assert(p:get() == &n)
  p:clear()
  assert(p == nilptr)
  local cp: *const integer? = &n
  assert(cp:has() and $cp:get() == 7)
  ## static_assert(cp.type.subtype.is_constpointer)
  local function next(x: *integer): *integer?
    return x
  end
  assert(next(&n) == &n and next(nilptr) == nil)
end

do -- functions use the niche layout
  local F = @function(): integer
  local function one(): integer return 1 end
  local f: F? = one
  assert(#@F? == #@F)
  assert(f:has() and f:get()() == 1)
  f = nilptr
  assert(f == nil and not f)
end

do -- optionals and variants mix
  local V = @variant(integer, string)
  local v: V = 1
  local ov: V? = nil
  assert(ov == nil)
  ov = v
  assert(ov ~= nil and ov:get():is(@integer) and ov:get() == 1)
  local oi: integer? = 3
  local w: integer|integer? = oi
  assert(w:is(@integer?) and w:get(@integer?) == 3)
end

do -- `?` propagation
  local function find(k: integer): integer?
    if k == 1 then return 10 end
    return nil
  end
  local function twice(k: integer): integer?
    return find(k)? * 2
  end
  assert(twice(1) == 20 and twice(2) == nil)
  local function sum(a: integer, b: integer): integer?
    return find(a)? + find(b)?
  end
  assert(sum(1, 1) == 20 and sum(1, 2) == nil and sum(2, 1) == nil)
end

do -- `?` over the stdlib `(value, errmsg, errcode)` triples
  local path = os.tmpname()
  local function write_lines(p: string): (boolean, string, integer)
    local f = io.open(p, 'w')?
    f:write('one\n')?
    f:write('two\n')?
    f:close()?
    return true, (@string){}, 0
  end
  local function second_line(p: string): string?
    local f = io.open(p)?
    defer f:close() end
    f:read('l')?
    return f:read('l')?
  end
  local function remove_ok(p: string): boolean
    os.remove(p)?
    return true
  end
  assert(write_lines(path))
  assert(second_line(path) == 'two')
  local ok, err = write_lines('/nonexistent/dir/x')
  assert(not ok and #err > 0)
  assert(second_line(path .. '.missing') == nil)
  assert(remove_ok(path) == true)
  assert(remove_ok(path) == false)
  assert(second_line(path) == nil)
end

do -- `orelse` evaluates the default only when empty
  local calls = 0
  local function dflt(): integer calls = calls + 1 return 7 end
  local function find(k: integer): integer?
    if k == 1 then return 10 end
    return nil
  end
  assert((find(1) orelse dflt()) == 10 and calls == 0)
  assert((find(2) orelse dflt()) == 7 and calls == 1)
  assert((find(2) orelse 3) == 3)
  local c: integer? = find(2) orelse find(1) -- chaining keeps the optional
  assert(c == 10)
  assert((find(2) orelse find(2) orelse 5) == 5)
  assert(find(2) orelse 1 == 1) -- `(find(2) orelse 1) == 1`
  local s: string? = nil
  assert((s orelse 'none') == 'none')
  local n = 4
  local p: *integer? = nilptr
  assert($(p orelse &n) == 4) -- a pointer optional yields the pointer
  local function word(k: integer): string?
    if k == 1 then return 'one' end
    return nil
  end
  assert((word(2) orelse word(1) orelse 'none') == 'one')
  assert((word(2) orelse word(2) orelse 'none') == 'none')
  assert(#(word(1) orelse '') == 3)
end

do -- `if local` binds the held value in the then block
  local function find(k: integer): integer?
    if k == 1 then return 10 end
    return nil
  end
  local seen = 0
  if local x = find(1) then
    seen = x
  end
  assert(seen == 10)
  if local x = find(2) then
    assert(false)
  elseif local y: float64 = find(1) then
    assert(y == 10.0)
    seen = 20
  else
    assert(false)
  end
  assert(seen == 20)
  local function g(k: integer): integer?
    if local v = find(k)? then return v + 1 end
    return nil
  end
  assert(g(1) == 11 and g(2) == nil)
  local s: string? = 'a'
  if local t = s then assert(t == 'a') else assert(false) end
end

do -- optionals in records and arrays
  local R = @record{id: integer, parent: integer?}
  local r: R = {id = 1}
  assert(r.parent == nil)
  r.parent = 2
  assert(r.parent == 2 and r.parent:get() == 2)
  local rs: [2]R = {{id = 1}, {id = 2, parent = 1}}
  assert(rs[0].parent == nil and rs[1].parent == 1)
end

print('optional ok')
