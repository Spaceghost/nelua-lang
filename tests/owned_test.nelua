require 'vector'
require 'allocators.general'

-- allocator counting deallocations, so a moved vector can be seen destroying exactly once
local deallocs: integer = 0
local CountingAllocator = @record{}
function CountingAllocator:alloc(size: usize, flags: facultative(usize)): pointer
  return general_allocator:alloc(size, flags)
end
function CountingAllocator:dealloc(p: pointer): void
  if p then deallocs = deallocs + 1 end
  general_allocator:dealloc(p)
end
## Allocator_implement_interface(CountingAllocator)

local closes = 0

-- a user owned record
local Buf <owned> = @record{data: pointer, size: usize}
function Buf.create(size: usize): Buf
  return Buf{data = general_allocator:alloc(size), size = size}
end
function Buf:__close()
  if self.data then
    general_allocator:dealloc(self.data)
    closes = closes + 1
  end
  self.data = nilptr
  self.size = 0
end
local function consume(b: Buf) -- takes ownership
  assert(b.size == 16)
  b:__close()
end

do -- move between variables and into a function
  local a: Buf = Buf.create(16)
  local pa = &a
  local b = move(a) -- `a` is zeroed, `b` owns the buffer
  assert(pa.data == nilptr and pa.size == 0)
  assert(b.data ~= nilptr and b.size == 16)
  a = Buf.create(8) -- live again
  assert(a.size == 8)
  consume(move(b))
  assert(closes == 1)
  a:__close()
  assert(closes == 2)
  a:__close() -- closing an emptied value is a no-op
  assert(closes == 2)
end

do -- moved into a <close> variable: closed exactly once, by the receiver
  local c: Buf = Buf.create(16)
  do
    local d <close> = move(c)
    assert(d.size == 16)
  end
  assert(closes == 3)
  c = Buf{}
end

local Box = @record{buf: Buf, n: integer} -- owned through its field
do
  local box: Box = {buf = Buf.create(16), n = 1}
  local box2 = move(box)
  assert(box2.buf.size == 16 and box2.n == 1)
  local taken = move(box2.buf)
  assert(taken.size == 16 and box2.buf.size == 0 and box2.buf.data == nilptr)
  consume(move(taken))
  assert(closes == 4)
end

local IVec = @vector(integer, CountingAllocator)

## if IVec.value.is_owned then
do -- a moved vector destroys exactly once
  local vec: IVec = {1, 2, 3}
  local pvec = &vec
  do
    local moved <close> = move(vec)
    assert(#moved == 3 and moved[0] == 1 and moved[2] == 3)
    assert(pvec.size == 0 and pvec.data.size == 0 and pvec.data.data == nilptr)
  end -- `moved` is destroyed here
  assert(deallocs == 1)
  vec = {4} -- live again
  assert(#vec == 1 and vec[0] == 4)
  vec:destroy()
  assert(deallocs == 2)

  local function fill(n: integer): IVec
    local v: IVec
    for i=1,n do v:push(i) end
    return v -- returning a local is a move
  end
  local function sum(v: IVec): integer -- takes ownership
    local total = 0
    for i=0,<#v do total = total + v[i] end
    v:destroy()
    return total
  end
  local v = fill(4)
  assert(sum(move(v)) == 10)
  assert(deallocs == 3)
end
## else
-- the vector is not annotated <owned>, box it in an owned record
local VecBox <owned> = @record{items: IVec}
function VecBox:__close()
  self.items:destroy()
end
do -- a moved vector destroys exactly once
  local box: VecBox = {items = {1, 2, 3}}
  local pbox = &box
  do
    local moved <close> = move(box)
    assert(#moved.items == 3 and moved.items[0] == 1 and moved.items[2] == 3)
    assert(#pbox.items == 0 and pbox.items.data.data == nilptr)
  end -- `moved` destroys the vector here
  assert(deallocs == 1)
  box = {items = {4}}
  assert(#box.items == 1 and box.items[0] == 4)
  box:__close()
  assert(deallocs == 2)
end
## end

print('owned OK!')
