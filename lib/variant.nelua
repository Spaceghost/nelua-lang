--[[
The variant library provides the variant generic, a tagged union (also known as sum type).

A variant holds one value out of a fixed list of types and remembers which one it holds.
It can be written as `variant(A, B, C)` or with the shorthand `A|B|C`, after `require 'variant'`.
A default initialized variant is empty, values of a member type convert to it implicitly,
and the held value is read back with `is`, `get` and `getptr`.

Variants of the same type compare with `==`, convert to a string with `tostring`
and dispatch on the held value with `visit`.

Remarks: `get` is checked, it raises a runtime error when another type is held.
]]

## if not pragmas.freestanding then
require 'string'
require 'stringbuilder'
## end

## local function make_variantT(...)
  ## local Ts = {...}
  ##[[
  static_assert(#Ts >= 1, 'variant requires at least one type')
  static_assert(#Ts <= 255, 'variant supports at most 255 types')
  local names = {}
  for i,T in ipairs(Ts) do
    static_assert(traits.is_type(T), "invalid type '%s' in variant", T)
    static_assert(not T.is_comptime, "variant cannot hold values of compile time type '%s'", T)
    static_assert(not T.is_void, "variant cannot hold values of type '%s'", T)
    for j=1,i-1 do
      static_assert(Ts[j] ~= T, "variant has duplicated type '%s'", T)
    end
    names[i] = tostring(T)
  end
  local nickname = 'variant('..table.concat(names, ', ')..')'
  -- 1-based index of type `T` among the variant members, or nil
  local function index_of(T)
    for i,U in ipairs(Ts) do
      if U == T then return i end
    end
  end
  ]]

  ##[[
  -- union of the member types, with fields `v1`, `v2`, ... in member order
  local variantU = types.UnionType({})
  for i,T in ipairs(Ts) do
    variantU:add_field('v'..i, T)
  end
  ]]

  -- Variant record defined when instantiating the generic `variant`.
  local variantT: type <nickname(#[nickname]#)> = @record{
    tag: uint8,
    u: #[variantU]#
  }

  ##[[
  local variantT = variantT.value
  variantT.is_variant = true
  variantT.subtypes = Ts
  variantT.types = Ts -- member types in declaration order, for preprocessor users
  ]]

  -- Concept matching values of any member type, choosing the member exactly matching
  -- the value type first and otherwise the single member it can convert to.
  local variantT_member_concept: type = #[concept(function(x)
    local xtype = x.type
    if xtype.is_variant and xtype == variantT then
      return false, 'already a variant'
    end
    if index_of(xtype) then
      return true
    end
    local matched
    for _,T in ipairs(Ts) do
      if T:is_convertible_from_attr(x) then
        if matched then
          return false, string.format("ambiguous conversion from '%s' to '%s': convertible to '%s' and '%s'",
            xtype, variantT, matched, T)
        end
        matched = T
      end
    end
    if matched then
      return matched
    end
    return false, string.format("no viable conversion from '%s' to '%s'", xtype, variantT)
  end)]#

  -- Initializes a variant holding `value`, used when implicitly converting member values.
  function variantT.__convert(value: variantT_member_concept): variantT <inline>
    local self: variantT
    ## local i = index_of(value.type)
    self.tag = #[i]#
    self.u.#|'v'..i|# = value
    return self
  end

  -- Sets the variant to hold `value`.
  function variantT:set(value: variantT_member_concept) <inline>
    ## local i = index_of(value.type)
    self.tag = #[i]#
    self.u.#|'v'..i|# = value
  end

  -- Clears the variant, making it empty.
  function variantT:clear() <inline>
    $self = (@variantT)()
  end

  -- Checks whether the variant is empty, that is, holds no value.
  function variantT:empty(): boolean <inline,nosideeffect>
    return self.tag == 0
  end

  -- Returns the 1-based index of the held type among the variant types, or 0 when empty.
  function variantT:index(): usize <inline,nosideeffect>
    return self.tag
  end

  -- Checks whether the variant holds a value of type `T`.
  function variantT:is(T: type): boolean <inline,nosideeffect>
    ## local i = index_of(T.value)
    ## static_assert(i, "type '%s' is not a member of '%s'", T.value, variantT)
    return self.tag == #[i]#
  end

  -- Returns the held value of type `T`, raises a runtime error when another type is held.
  function variantT:get(T: type): #[T.value]# <inline>
    ## local i = index_of(T.value)
    ## static_assert(i, "type '%s' is not a member of '%s'", T.value, variantT)
    check(self.tag == #[i]#, 'variant does not hold a value of the requested type')
    return self.u.#|'v'..i|#
  end

  -- Returns a pointer to the held value of type `T`, or nilptr when another type is held.
  function variantT:getptr(T: type): *#[T.value]# <inline,nosideeffect>
    ## local i = index_of(T.value)
    ## static_assert(i, "type '%s' is not a member of '%s'", T.value, variantT)
    if self.tag ~= #[i]# then
      return nilptr
    end
    return &self.u.#|'v'..i|#
  end

  --[[
  Compares two variants, they are equal when both are empty,
  or when they hold the same type and the held values compare equal with `==`.
  Values of a member type convert to the variant first, so `v == 3` works.
  Comparing with a variant of another type is a compile error.
  ]]
  function variantT.__eq(a: variantT, b: variantT): boolean
    if a.tag ~= b.tag then return false end
    ## for i=1,#Ts do
    if a.tag == #[i]# then
      return a.u.#|'v'..i|# == b.u.#|'v'..i|#
    end
    ## end
    return true -- both empty
  end

  --[[
  Calls `f` with the held value and returns its result, `f` is usually a polymorphic
  function or a closure accepting every member type. The results of all branches must
  agree on a common type. Raises a runtime error when the variant is empty.
  ]]
  function variantT:visit(f: auto)
    check(self.tag ~= 0, 'attempt to visit an empty variant')
    ## for i=1,#Ts-1 do
    if self.tag == #[i]# then
      return f(self.u.#|'v'..i|#)
    end
    ## end
    return f(self.u.#|'v'..#Ts|#)
  end

  ## if not pragmas.freestanding then
  --[[
  Converts the variant to a new string in the form `variant(A, B): <held value>`,
  or `variant(A, B): empty` when empty. The held value is converted with `tostring`.
  ]]
  function variantT:__tostring(): string <polymorphic>
    local sb: stringbuilder
    sb:write(#[nickname]#, ': ')
    ## for i=1,#Ts do
    if self.tag == #[i]# then
      sb:write(self.u.#|'v'..i|#)
      return sb:promote()
    end
    ## end
    sb:write('empty')
    return sb:promote()
  end
  ## end

  ## return variantT
## end

-- Generic used to instantiate variant types in the form of `variant(A, B, ...)` or `A|B|...`.
global variant: type = #[generalize(make_variantT)]#

return variant
