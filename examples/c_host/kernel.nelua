-- A C host owns memory and main(); these leaf callbacks need no runtime setup.
## pragmas.nogc = true
## pragmas.noentrypoint = true
## pragmas.nochecks = true
## cfile 'host.c'
## cinclude 'host.h'

local host_buffer: type <cimport,nodecl> = @record{
  data: *[0]byte,
  length: csize,
  capacity: csize
}
local function memcpy(dest: pointer, src: pointer, size: csize): pointer
  <cimport,cinclude '<string.h>',nodecl> end

-- Checks stay explicit even in release mode; no panic/abort handler is needed.
local function append(buffer: *host_buffer, data: *[0]byte, length: csize): boolean
  if buffer == nilptr or buffer.length > buffer.capacity or
     length > buffer.capacity - buffer.length then return false end
  if length > 0 then
    if buffer.data == nilptr or data == nilptr then return false end
    memcpy(&buffer.data[buffer.length], data, length)
    buffer.length = buffer.length + length
  end
  return true
end

local function literal(buffer: *host_buffer, value: cstring, length: csize): boolean <inline>
  return append(buffer, (@*[0]byte)(value), length)
end

-- Input is an explicit borrowed byte span, so embedded NUL is not a terminator.
-- The host guarantees valid UTF8; the kernel only escapes JSON special bytes.
local function host_json_string(buffer: *host_buffer, data: *[0]byte, length: csize): boolean
  <cexport,codename 'host_json_string'>
  if length > 0 and data == nilptr then return false end
  if not literal(buffer, '"', 1) then return false end
  local first: csize = 0
  local i: csize = 0
  while i < length do
    local value = data[i]
    if value < 32 or value == 34 or value == 92 then
      if i > first and not append(buffer, &data[first], i - first) then return false end
      local escape: [6]byte <noinit>
      escape[0] = 92
      local count: csize = 2
      if value == 34 or value == 92 then
        escape[1] = value
      else
        escape[1], escape[2], escape[3] = 117, 48, 48
        local low = value & 15
        escape[4] = (value >> 4) + 48
        if low < 10 then escape[5] = low + 48 else escape[5] = low + 87 end
        count = 6
      end
      if not append(buffer, (@*[0]byte)(&escape[0]), count) then return false end
      first = i + 1
    end
    i = i + 1
  end
  if length > first and not append(buffer, &data[first], length - first) then return false end
  return literal(buffer, '"', 1)
end

local function host_decimal_i64(buffer: *host_buffer, value: int64): boolean
  <cexport,codename 'host_decimal_i64'>
  local digits: [20]byte <noinit>
  local magnitude: uint64
  if value < 0 then
    if not literal(buffer, '-', 1) then return false end
    magnitude = uint64(-(value + 1)) + 1 -- also defined for INT64_MIN
  else magnitude = uint64(value) end
  local first: csize = 20
  repeat
    first = first - 1
    digits[first] = byte(magnitude % 10 + 48)
    magnitude = magnitude // 10
  until magnitude == 0
  return append(buffer, (@*[0]byte)(&digits[first]), 20 - first)
end
